# Google Places API (New) — server-side key, restricted to "Places API (New)" only
GOOGLE_PLACES_API_KEY=your_key_here

# Airtable — scoped Personal Access Token for THIS app only (read + write on the one base below)
AIRTABLE_PAT_REVIEW_AGGREGATOR=your_token_here
AIRTABLE_BASE_ID=your_base_id_here

# Resend — reusing Bathshack's existing Resend account/sending domain
RESEND_API_KEY=your_key_here
DIGEST_FROM_EMAIL=reviews@email.bathshapp.com
DIGEST_TO_EMAIL=chris.mckee@bathshack.com

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" when invoking the job.
# Generate any long random string (e.g. `openssl rand -hex 32`) and set the same value here and in Vercel.
CRON_SECRET=your_random_secret_here
